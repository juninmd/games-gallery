{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs plus launching store URIs from an allow-list",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://store.steampowered.com/*" },
        { "url": "https://api.steampowered.com/*" },
        { "url": "https://api.rawg.io/*" },
        { "url": "https://store-site-backend-static.ak.epicgames.com/freeGamesPromotions*" },
        { "url": "https://blog.playstation.com/feed/*" },
        { "url": "https://catalog.gog.com/v1/catalog*" },
        { "url": "https://www.protondb.com/api/v1/reports/summaries/*" },
        { "url": "https://catalog.gamepass.com/sigls/v2*" },
        { "url": "https://displaycatalog.mp.microsoft.com/v7.0/products*" },
        { "url": "https://api.amazon.com/auth/register" },
        { "url": "https://api.amazon.com/auth/deregister" },
        { "url": "https://gaming.amazon.com/api/distribution/entitlements" },
        { "url": "https://account-public-service-prod03.ol.epicgames.com/account/api/oauth/*" },
        { "url": "https://library-service.live.use1a.on.epicgames.com/library/api/public/items*" },
        { "url": "https://catalog-public-service-prod06.ol.epicgames.com/catalog/api/shared/namespace/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "steam://*" },
        { "url": "goggalaxy://*" },
        { "url": "com.epicgames.launcher://*" },
        { "url": "uplay://*" },
        { "url": "battlenet://*" },
